#!/bin/bash

# Kingdom Age screensaver: honey-gold + fig-leaf Matrix rain over RSS (or verses).
# Each monitor gets its own slice of the feeds.

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.omarchy.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true
  pkill -x ttfx 2>/dev/null
  pkill -f '[o]rg.omarchy.screensaver' 2>/dev/null
  exit 0
}

trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:17/14/0f\007'

hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null || hyprctl keyword cursor:invisible true &>/dev/null

tty=$(tty 2>/dev/null)

wait_for_terminal_resize() {
  local deadline=$((SECONDS + 2))
  while ((SECONDS < deadline)) && [[ $(stty size 2>/dev/null) == "24 80" ]]; do
    sleep 0.02
  done
}

wait_for_terminal_resize

branding="${HOME}/.config/omarchy/branding/screensaver.txt"
feeds_py="${HOME}/.config/omarchy/themes/kingdom-age/scripts/screensaver-feeds.py"
if [[ ! -f $feeds_py ]]; then
  feeds_py="${HOME}/.config/omarchy/themes/1-kingdom-age-v2/scripts/screensaver-feeds.py"
fi
if [[ ! -f $feeds_py ]]; then
  feeds_py="/home/luke/dev/omatheme/kingdom-age/scripts/screensaver-feeds.py"
fi

kingdom_age_active() {
  [[ -f $branding ]] && grep -q 'KINGDOM AGE' "$branding" 2>/dev/null
}

discover_monitor() {
  if [[ -n ${KINGDOM_AGE_MONITOR:-} ]]; then
    printf '%s\n' "$KINGDOM_AGE_MONITOR"
    return
  fi
  local ppid mon
  ppid=$(ps -o ppid= -p $$ 2>/dev/null | tr -d ' ')
  mon=$(hyprctl clients -j 2>/dev/null | jq -r --argjson pid "${ppid:-0}" '
    (.[] | select(.pid == $pid) | .monitor | tostring) // empty
  ' | head -1)
  if [[ $mon =~ ^[0-9]+$ ]]; then
    hyprctl monitors -j | jq -r --argjson id "$mon" '.[] | select(.id == $id) | .name' | head -1
    return
  fi
  [[ -n $mon ]] && printf '%s\n' "$mon" && return
  printf '%s\n' "screen"
}

script_path="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null; then
  script_path="$(readlink -f "$script_path" 2>/dev/null || echo "$script_path")"
fi
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
rss_helper="$script_dir/omarchy-screensaver-rss"
if [[ ! -x $rss_helper ]]; then
  rss_helper="${HOME}/.config/omarchy/themes/kingdom-age/scripts/omarchy-screensaver-rss"
fi

# Prefer a cached RSS item (title + quote). Fall back to branding verses.
screensaver_input() {
  if [[ -x $rss_helper ]]; then
    local picked
    picked="$("$rss_helper" pick 2>/dev/null || true)"
    if [[ -n $picked && -f $picked ]] && grep -q 'KINGDOM AGE' "$picked" 2>/dev/null; then
      printf '%s\n' "$picked"
      return
    fi
  fi
  printf '%s\n' "$branding"
}

run_ttfx() {
  local input="$branding"
  local monitor

  if kingdom_age_active; then
    # Prefer the PR RSS helper (cached item). Fall back to main's
    # per-monitor feed builder, then the branding verses.
    input="$(screensaver_input)"
    if [[ $input == "$branding" && -f $feeds_py ]]; then
      monitor=$(discover_monitor)
      built=$(python3 "$feeds_py" "$monitor" 2>/dev/null || true)
      [[ -n $built && -f $built ]] && input="$built"
    fi

    # Fill the terminal. Pin canvas to the top-left so leftover cells are not
    # a centered black frame. Soil fill matches Ghostty/Alacritty/Foot.
    ttfx -i "$input" \
      --frame-rate 120 --canvas-width -1 --canvas-height -1 --reuse-canvas \
      --anchor-canvas nw --anchor-text c --no-eol --no-restore-cursor \
      --terminal-background-color '#17140f' \
      matrix \
      --rain-time 10 \
      --highlight-color f4e8d6 \
      --rain-color-gradient d4a054 e0b85a c4924a 8f7a3a 6f9a4a 3d5a28 \
      --final-gradient-stops f4e8d6 d4a054 6f9a4a \
      --final-gradient-direction radial \
      --rain-symbols A E I O U T H S N R L D M C G F B Y W P K V . : + '|' ¦ '*' 2 5 9
  else
    ttfx -i "$input" \
      --frame-rate 120 --canvas-width -1 --canvas-height -1 --reuse-canvas \
      --anchor-canvas nw --anchor-text c \
      --random-effect --no-eol --no-restore-cursor --terminal-background-color '#17140f'
  fi
}

while true; do
  run_ttfx &

  while pgrep -t "${tty#/dev/}" -x ttfx >/dev/null; do
    if read -n1 -t 1 || ! screensaver_in_focus; then
      exit_screensaver
    fi
  done
done
