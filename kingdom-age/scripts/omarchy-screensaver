#!/bin/bash

# Kingdom Age screensaver: honey/fig Matrix rain. Verse-words fall like Tetris
# and stack into garden silhouettes, then reverse-rain into the next verse.

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.omarchy.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true
  [[ -n ${rain_pid:-} ]] && kill "$rain_pid" 2>/dev/null || true
  pkill -x ttfx 2>/dev/null
  pkill -f '[k]ingdom-rain.py' 2>/dev/null
  pkill -f '[o]rg.omarchy.screensaver' 2>/dev/null
  exit 0
}

trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:17/14/0f\007'

hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null || hyprctl keyword cursor:invisible true &>/dev/null

tty=$(tty 2>/dev/null)

wait_for_terminal_resize() {
  local deadline=$((SECONDS + 3))
  local prev="" cur=""
  local stable=0
  while ((SECONDS < deadline)); do
    cur=$(stty size 2>/dev/null || echo "24 80")
    if [[ $cur != "24 80" && $cur == "$prev" ]]; then
      stable=$((stable + 1))
      ((stable >= 4)) && return 0
    else
      stable=0
    fi
    prev=$cur
    sleep 0.04
  done
}

wait_for_terminal_resize

script_path="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null; then
  script_path="$(readlink -f "$script_path" 2>/dev/null || echo "$script_path")"
fi
script_dir="$(cd "$(dirname "$script_path")" && pwd)"

branding="${HOME}/.config/omarchy/branding/screensaver.txt"
rain_py="$script_dir/kingdom-rain.py"
if [[ ! -f $rain_py ]]; then
  rain_py="${HOME}/.config/omarchy/themes/kingdom-age/scripts/kingdom-rain.py"
fi
if [[ ! -f $rain_py ]]; then
  rain_py="/home/luke/dev/omatheme/kingdom-age/scripts/kingdom-rain.py"
fi

kingdom_age_active() {
  [[ -f $branding ]] && grep -q 'KINGDOM AGE' "$branding" 2>/dev/null
}

discover_monitor() {
  if [[ -n ${KINGDOM_AGE_MONITOR:-} ]]; then
    printf '%s\n' "$KINGDOM_AGE_MONITOR"
    return
  fi
  local ppid mon
  ppid=$(ps -o ppid= -p $$ 2>/dev/null | tr -d ' ')
  mon=$(hyprctl clients -j 2>/dev/null | jq -r --argjson pid "${ppid:-0}" '
    (.[] | select(.pid == $pid) | .monitor | tostring) // empty
  ' | head -1)
  if [[ $mon =~ ^[0-9]+$ ]]; then
    hyprctl monitors -j | jq -r --argjson id "$mon" '.[] | select(.id == $id) | .name' | head -1
    return
  fi
  [[ -n $mon ]] && printf '%s\n' "$mon" && return
  printf '%s\n' "screen"
}

watch_pid() {
  local pid="$1"
  local deadline=$((SECONDS + 2))
  while ((SECONDS < deadline)) && ! kill -0 "$pid" 2>/dev/null; do
    sleep 0.03
  done
  while kill -0 "$pid" 2>/dev/null; do
    if read -n1 -t 1 || ! screensaver_in_focus; then
      exit_screensaver
    fi
  done
}

monitor=$(discover_monitor)

while true; do
  if kingdom_age_active && [[ -f $rain_py ]]; then
    python3 "$rain_py" --monitor "$monitor" --hold 15 --fps 24 &
    rain_pid=$!
    watch_pid "$rain_pid"
    rain_pid=""
  else
    ttfx -i "$branding" \
      --frame-rate 60 --canvas-width 0 --canvas-height 0 \
      --anchor-canvas c --anchor-text c \
      --random-effect --no-eol --no-restore-cursor --terminal-background-color '#17140f' &
    watch_pid $!
  fi
done
